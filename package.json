{
  "name": "whatsapp-archive-viewer",
  "version": "1.1.0",
  "private": true,
  "description": "Local-only viewer for exported WhatsApp chat ZIP archives",
  "author": "Private local app",
  "type": "module",
  "main": "build/electron-main.cjs",
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "start:server": "tsx server/start.ts",
    "dev": "concurrently -k \"tsx watch server/start.ts\" \"vite\"",
    "build": "vite build",
    "build:binaries": "node scripts/package-binaries.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "local.whatsapp.archive.viewer",
    "productName": "WhatsApp Archive Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/electron-main.cjs",
      "dist/**/*"
    ],
    "asar": true,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "whatsapp-archive-viewer-${os}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "whatsapp-archive-viewer-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "whatsapp-archive-viewer-${os}-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "express": "^4.21.2",
    "open": "^10.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.5",
    "vite": "^6.3.5",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "fflate": "^0.8.2",
    "postcss": "^8.5.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
