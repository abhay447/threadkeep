{
  "name": "whatsapp-archive-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Local-only viewer for exported WhatsApp chat ZIP archives",
  "type": "module",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "express": "^4.21.2",
    "open": "^10.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.5",
    "vite": "^6.3.5",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "fflate": "^0.8.2",
    "postcss": "^8.5.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
